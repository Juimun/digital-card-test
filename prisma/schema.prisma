generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  links       ProfileLink[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ProfileLink {
  id        Int     @id @default(autoincrement())
  label     String
  url       String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId Int
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId Int

  @@unique([profileId, name])
}

model Experience {
  id           Int      @id @default(autoincrement())
  company      String
  position     String
  periodStart  DateTime
  periodEnd    DateTime?
  achievements String[]
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    Int
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  url         String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   Int
}
